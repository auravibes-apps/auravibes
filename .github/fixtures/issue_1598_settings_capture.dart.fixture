import 'dart:convert';
import 'dart:io';
import 'dart:ui' as ui;

import 'package:auravibes_app/data/database/drift/app_database.dart';
import 'package:auravibes_app/features/settings/screens/workspace_settings_screen.dart';
import 'package:auravibes_app/features/workspaces/providers/workspace_repository_providers.dart';
import 'package:auravibes_app/flavor.dart';
import 'package:auravibes_app/main.dart';
import 'package:auravibes_app/main/main_locale.dart';
import 'package:auravibes_app/providers/app_providers.dart';
import 'package:auravibes_app/providers/router_providers.dart';
import 'package:auravibes_app/router/workspace_route.dart';
import 'package:auravibes_ui/ui.dart';
import 'package:crypto/crypto.dart';
import 'package:drift/native.dart';
import 'package:flutter/rendering.dart';
import 'package:flutter/services.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:hooks_riverpod/hooks_riverpod.dart';
import 'package:material_ui/material_ui.dart';
import 'package:path_provider_linux/path_provider_linux.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'package:shared_preferences_linux/shared_preferences_linux.dart';

void main() {
  testWidgets('issue 1598 actual workspace settings production route', (tester) async {
    const workspaceId = '019a1e91-0000-7000-8000-000000001598';
    const outputPath = String.fromEnvironment('HOOK_CAPTURE_DIR');
    const sourceSha = String.fromEnvironment('HOOK_CAPTURE_SHA');
    const label = String.fromEnvironment('HOOK_CAPTURE_LABEL');
    expect(outputPath, isNotEmpty);
    expect(sourceSha, matches(RegExp(r'^[0-9a-f]{40}$')));
    expect(label, anyOf('before', 'after'));
    final output = Directory(outputPath);
    final storage = await Directory.systemTemp.createTemp('aura-hooks-capture-');
    final database = AppDatabase(connection: NativeDatabase(File('${storage.path}/app.sqlite')));
    final container = ProviderContainer(overrides: [appDatabaseProvider.overrideWithValue(database)]);
    addTearDown(container.dispose);
    addTearDown(database.close);
    addTearDown(() => storage.delete(recursive: true));
    tester.view.devicePixelRatio = 1;
    tester.view.physicalSize = const Size(1280, 1200);
    addTearDown(tester.view.resetPhysicalSize);
    addTearDown(tester.view.resetDevicePixelRatio);
    tester.platformDispatcher.textScaleFactorTestValue = 1;
    addTearDown(tester.platformDispatcher.clearTextScaleFactorTestValue);
    tester.platformDispatcher.accessibilityFeaturesTestValue = const FakeAccessibilityFeatures(disableAnimations: true);
    addTearDown(tester.platformDispatcher.clearAccessibilityFeaturesTestValue);
    final fonts = <Map<String, String>>[];
    await tester.runAsync(() async {
      PathProviderLinux.registerWith();
      SharedPreferencesLinux.registerWith();
      SharedPreferences.resetStatic();
      final preferences = await SharedPreferences.getInstance();
      final _ = await preferences.clear();
      final _ = await preferences.setInt('app_theme', 0);
      final _ = await preferences.setDouble('app_accent_hue', 186);
      final _ = await preferences.setString('app_language_preference', 'english');
      await MainLocale.ensureInitialized();
      AppFlavorConfig.instance.setAppFlavor(.prod);
      final _ = await database.workspaceDao.insertWorkspace(.insert(
        id: .new(workspaceId),
        createdAt: .new(.utc(2026, 10, 30)),
        updatedAt: .new(.utc(2026, 10, 30)),
        name: 'Research workspace',
        type: .local,
      ));
      expect((await container.read(workspaceRepositoryProvider).getWorkspaceById(workspaceId))?.name, 'Research workspace');
      for (final font in const {
        'Inter': 'assets/fonts/Inter.ttf',
        'JetBrains Mono': 'packages/gpt_markdown/lib/fonts/JetBrainsMono-Regular.ttf',
        'packages/gpt_markdown/JetBrainsMono': 'packages/gpt_markdown/lib/fonts/JetBrainsMono-Regular.ttf',
        'MaterialIcons': 'fonts/MaterialIcons-Regular.otf',
      }.entries) {
        final data = await rootBundle.load(font.value);
        await (FontLoader(font.key)..addFont(Future.value(data))).load();
        fonts.add({'family': font.key, 'source': font.value, 'sha256': sha256.convert(data.buffer.asUint8List(data.offsetInBytes, data.lengthInBytes)).toString()});
      }
      final sdk = Platform.environment['FLUTTER_ROOT'];
      expect(sdk, isNotNull);
      final roboto = await File('$sdk/bin/cache/artifacts/material_fonts/Roboto-Regular.ttf').readAsBytes();
      await (FontLoader('Roboto')..addFont(Future.value(roboto.buffer.asByteData()))).load();
      fonts.add({'family': 'Roboto', 'source': 'Flutter SDK Roboto-Regular.ttf', 'sha256': sha256.convert(roboto).toString()});
      final router = container.read(routerProvider);
      router.go(WorkspaceSettingsRoute(workspaceId: workspaceId).location);
      await tester.pumpWidget(UncontrolledProviderScope(
        container: container,
        child: const MainLocale(child: RepaintBoundary(key: ValueKey('issue1598-production-capture'), child: MyApp())),
      ));
    });
    for (var attempt = 0; attempt < 150; attempt++) {
      await tester.runAsync(() => Future<void>.delayed(const Duration(milliseconds: 20)));
      await tester.pump(const Duration(milliseconds: 100));
      if (find.byType(WorkspaceSettingsScreen).evaluate().isNotEmpty && find.byType(AuraSpinner).evaluate().isEmpty && !tester.binding.hasScheduledFrame) break;
    }
    expect(find.byType(WorkspaceSettingsScreen), findsOneWidget);
    expect(find.byType(AuraSpinner), findsNothing);
    expect(tester.takeException(), isNull);
    final route = container.read(routerProvider).routeInformationProvider.value.uri.toString();
    expect(route, WorkspaceSettingsRoute(workspaceId: workspaceId).location);
    expect(find.text('Research workspace'), findsWidgets);
    final boundary = tester.renderObject<RenderRepaintBoundary>(find.byKey(const ValueKey('issue1598-production-capture')));
    await tester.runAsync(() async {
      final _ = await output.create(recursive: true);
      final image = await boundary.toImage(pixelRatio: 1);
      final bytes = await image.toByteData(format: ui.ImageByteFormat.png);
      image.dispose();
      final _ = await File('${output.path}/$label.png').writeAsBytes(bytes!.buffer.asUint8List());
      final _ = await File('${output.path}/$label.json').writeAsString(const JsonEncoder.withIndent('  ').convert({
        'sourceSha': sourceSha,
        'route': route,
        'workspaceId': workspaceId,
        'seed': 'persisted local Research workspace, no connections or hook opt-in',
        'root': 'MyApp with production routerProvider and feature providers',
        'storage': 'real file-backed Drift SQLite and real SharedPreferencesLinux under isolated XDG directories',
        'infrastructureOverride': 'appDatabaseProvider points to the isolated real SQLite database',
        'credentialBoundary': 'repository flutter_test_config uses empty in-memory secure storage; no credentials or cloud accounts are seeded',
        'renderer': 'Flutter widget-test Skia on ${Platform.operatingSystem}',
        'viewport': [1280, 1200],
        'locale': 'en',
        'theme': 'light',
        'textScale': 1,
        'devicePixelRatio': 1,
        'fonts': fonts,
        'limitations': 'Native OS window chrome, native credential storage, and assistive technology are not captured.',
      }));
    });
    await tester.pumpWidget(const SizedBox.shrink());
  });
}
