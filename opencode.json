{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "prettier": {
      "command": ["npx", "-y", "prettier", "--write", "$FILE"],
      "extensions": [".json", ".yaml", ".md", ".html"]
    },
    "dart": {
      "command": ["bash", "scripts/format-dart.sh", "$FILE"],
      "extensions": [".dart"]
    }
  },
  "mcp": {
    "servers": {
      "dart": {
        "disabled": false,
        "type": "local",
        "command": ["fvm", "dart", "mcp-server", "--force-roots-fallback"]
      },
      "marionette": {
        "disabled": false,
        "type": "local",
        "command": ["fvm", "dart", "run", "marionette_mcp"]
      },
      "pubdev": {
        "type": "local",
        "command": ["npx", "-y", "@devqxi/pubdev-mcp-server@1.0.1"],
        "disabled": false
      },
      "serverpod": {
        "disabled": false,
        "type": "local",
        "command": [
          "serverpod",
          "mcp-server",
          "--server-dir",
          "apps/auravibes_server"
        ]
      },
      "sonarqube": {
        "type": "local",
        "command": ["sonar", "run", "mcp"],
        "disabled": false
      }
    }
  }
}
