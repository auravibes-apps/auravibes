{
  "settings": {
    "toolPrefix": "server",
    "idleTimeout": 10,
    "outputGuard": true
  },
  "mcpServers": {
    "dart": {
      "command": "fvm",
      "args": [
        "dart",
        "mcp-server",
        "--force-roots-fallback"
      ],
      "lifecycle": "lazy",
      "directTools": true
    },
    "pubdev": {
      "command": "npx",
      "args": [
        "-y",
        "@devqxi/pubdev-mcp-server"
      ],
      "lifecycle": "lazy",
      "directTools": true
    },
    "serverpod": {
      "command": "serverpod",
      "args": [
        "mcp-server",
        "--server-dir",
        "apps/auravibes_server"
      ],
      "lifecycle": "lazy"
    },
    "marionette": {
      "command": "dart",
      "args": [
        "pub",
        "global",
        "run",
        "marionette_mcp"
      ],
      "lifecycle": "lazy",
      "directTools": true
    },
    "sonarqube": {
      "command": "sonar",
      "args": [
        "run",
        "mcp"
      ],
      "lifecycle": "lazy"
    }
  }
}
