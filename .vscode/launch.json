{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "dev Debug",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "cwd": "apps/auravibes_app",
      "toolArgs": [
        "--flavor",
        "dev",
        "--dart-define=AURAVIBES_SERVER_URL=http://localhost:8080/",
        "--dart-define=ENABLE_FLUTTER_DRIVER=true"
      ],
      "program": "lib/main.dart"
    },
    {
      "name": "dev Debug (DB hash source)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "cwd": "apps/auravibes_app",
      "toolArgs": [
        "--flavor",
        "dev",
        "--dart-define=AURAVIBES_SERVER_URL=http://localhost:8080/",
        "--dart-define=DB_HASH_SOURCE=${workspaceFolder}",
        "--dart-define=ENABLE_FLUTTER_DRIVER=true"
      ],
      "program": "lib/main.dart"
    },
    {
      "name": "AuraVibes Server",
      "request": "launch",
      "type": "dart",
      "cwd": "apps/auravibes_server",
      "program": "bin/main.dart",
      "args": ["--mode", "development", "--apply-migrations"]
    },
    {
      "name": "Widgetbook",
      "cwd": "widgetbook",
      "request": "launch",
      "type": "dart"
    }
  ]
}
